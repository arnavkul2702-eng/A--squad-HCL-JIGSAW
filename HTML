        :root[data-theme="cyberpunk"] {
            --bg-grad: linear-gradient(135deg, #090a0f 0%, #121824 50%, #1a0b2e 100%);
            --card-bg: rgba(18, 24, 38, 0.75);
            --card-border: rgba(0, 243, 255, 0.3);
