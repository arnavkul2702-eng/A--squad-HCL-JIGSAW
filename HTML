    <!-- JavaScript for Simulation & Interactivity -->
    <script>
        // Theme Switcher
        function setTheme(themeName) {
            document.documentElement.setAttribute('data-theme', themeName);
        }

        // Tab Switcher
        function switchTab(tabId) {
            ['simulation', 'telemetry', 'innovation', 'team'].forEach(id => {
                document.getElementById('tab-' + id).classList.add('hidden');
                document.getElementById('btn-' + id).classList.remove('active', 'bg-cyan-500', 'text-black');
                document.getElementById('btn-' + id).classList.add('text-slate-300', 'hover:bg-slate-800');
            });
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            const activeBtn = document.getElementById('btn-' + tabId);
            activeBtn.classList.add('active');
            activeBtn.classList.remove('text-slate-300', 'hover:bg-slate-800');
        }

        // Sliders & Controls
        let currentSpeed = 65;
        let currentSun = 85;
        let aiEngaged = true;

        function updateSpeed(val) {
            currentSpeed = val;
            document.getElementById('val-speed').innerText = val + ' km/h';
            document.getElementById('sim-speed-badge').innerText = val + ' KM/H';
            document.getElementById('stat-regen').innerText = (val * 0.18).toFixed(1) + ' kW';
        }

        function updateSun(val) {
            currentSun = val;
            document.getElementById('val-sun').innerText = val + '%';
            document.getElementById('hud-solar').innerText = val + '%';
            document.getElementById('stat-solar').innerText = (val * 0.056).toFixed(1) + ' kW/h';
        }

        function toggleAI() {
            aiEngaged = !aiEngaged;
            const badge = document.getElementById('ai-status');
            if(aiEngaged) {
                badge.innerText = "ENGAGED";
                badge.className = "text-emerald-400 text-xs font-bold font-mono";
            } else {
                badge.innerText = "MANUAL";
                badge.className = "text-amber-400 text-xs font-bold font-mono";
            }
        }

        function triggerEmergencyBrake() {
            let origSpeed = currentSpeed;
            currentSpeed = 10;
            document.getElementById('range-speed').value = 10;
            updateSpeed(10);
            document.getElementById('hud-regen').innerText = "MAX REGEN!";
            setTimeout(() => {
                currentSpeed = origSpeed;
                document.getElementById('range-speed').value = origSpeed;
                updateSpeed(origSpeed);
                document.getElementById('hud-regen').innerText = "Active";
            }, 1500);
        }

        // Canvas Simulation
        const canvas = document.getElementById('truckCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        let roadOffset = 0;
        let particles = [];
        for(let i=0; i<30; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: canvas.height - 80 + (Math.random() * 40),
                speed: 2 + Math.random() * 4,
                size: 1 + Math.random() * 2
            });
        }

        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Draw Background Sky / Grid
            ctx.fillStyle = '#090a0f';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw Horizon Glow
            let grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
            grad.addColorStop(0, 'rgba(0, 243, 255, 0.05)');
            grad.addColorStop(1, 'rgba(0, 0, 0, 0.8)');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw Road
            const roadY = canvas.height - 90;
            ctx.fillStyle = '#121824';
            ctx.fillRect(0, roadY, canvas.width, 90);

            // Road markings
            roadOffset = (roadOffset + currentSpeed * 0.1) % 40;
            ctx.strokeStyle = '#00f3ff';
            ctx.lineWidth = 3;
            ctx.setLineDash([20, 20]);
            ctx.lineDashOffset = -roadOffset;
            ctx.beginPath();
            ctx.moveTo(0, roadY + 45);
            ctx.lineTo(canvas.width, roadY + 45);
            ctx.stroke();
            ctx.setLineDash([]);

            // Draw Particles (Energy Flow)
            ctx.fillStyle = '#39ff14';
            particles.forEach(p => {
                p.x -= p.speed * (currentSpeed / 50);
                if(p.x < 0) p.x = canvas.width;
                ctx.fillRect(p.x, p.y, p.size * 2, p.size);
            });

            // Draw Smart Truck (Semi-Trailer 18-Wheeler)
            const truckX = canvas.width / 2 - 120;
            const truckY = roadY - 75;

            // Trailer
            ctx.fillStyle = '#1e293b';
            ctx.strokeStyle = '#00f3ff';
            ctx.lineWidth = 2;
            ctx.fillRect(truckX - 100, truckY + 5, 200, 55);
            ctx.strokeRect(truckX - 100, truckY + 5, 200, 55);

            // Solar Roof Panels on Trailer
            ctx.fillStyle = '#38bdf8';
            for(let i=0; i<6; i++) {
                ctx.fillRect(truckX - 90 + (i * 32), truckY + 2, 28, 5);
            }

            // Truck Cab
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(truckX + 100, truckY - 10, 75, 70);
            ctx.strokeRect(truckX + 100, truckY - 10, 75, 70);

            // Cab Windshield
            ctx.fillStyle = 'rgba(0, 243, 255, 0.3)';
            ctx.fillRect(truckX + 145, truckY, 25, 30);

            // Wheels (18-wheeler dual setup represented)
            const wheelRadius = 16;
            const wheelY = roadY + 5;
            [truckX - 80, truckX - 50, truckX + 20, truckX + 110, truckX + 145].forEach(wx => {
                ctx.fillStyle = '#000';
                ctx.beginPath();
                ctx.arc(wx, wheelY, wheelRadius, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = '#39ff14';
                ctx.lineWidth = 3;
                ctx.stroke();

                // Hubcap
                ctx.fillStyle = '#00f3ff';
                ctx.beginPath();
                ctx.arc(wx, wheelY, 5, 0, Math.PI * 2);
                ctx.fill();
            });

            // Autonomous Sensor Ring atop cab
            ctx.fillStyle = '#ff007f';
            ctx.beginPath();
            ctx.arc(truckX + 130, truckY - 15, 4, 0, Math.PI * 2);
            ctx.fill();

            requestAnimationFrame(animate);
        }
        animate();
    </script>
</body>
</html>
